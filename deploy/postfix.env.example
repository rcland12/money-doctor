# Postfix relay for the morning email (compose profile "email").
# Copy to deploy/postfix.env (git-ignored).
#
# Gmail: turn on 2-Step Verification, then make an app password at
# https://myaccount.google.com/apppasswords and paste it below.
# In .env set: SMTP_HOST=postfix  SMTP_PORT=25  SMTP_FROM=Money Doctor <you@gmail.com>
# Gmail sends as the account you log in with, whatever SMTP_FROM says.

RELAYHOST=[smtp.gmail.com]:587
RELAYHOST_USERNAME=you@gmail.com
RELAYHOST_PASSWORD=
# Domains the app may send from (the part after @ in SMTP_FROM).
ALLOWED_SENDER_DOMAINS=gmail.com
HOSTNAME=money-doctor-mail

# Another provider (Fastmail, Mailgun, Resend, SES, ...): use its SMTP host,
# port 587, and the username and password it gives you.
# RELAYHOST=[smtp.example.com]:587
