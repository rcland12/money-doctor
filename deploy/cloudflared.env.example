# Cloudflare Tunnel (compose profile "tunnel"). Copy to deploy/cloudflared.env (git-ignored).
#
# 1. Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> Create a tunnel
#    (type Cloudflared). Copy the token from the install command it shows.
# 2. In the tunnel, add a Public Hostname: money.example.com -> HTTP -> nginx:8080
# 3. Set MD_PUBLIC_URL=https://money.example.com in .env.

TUNNEL_TOKEN=
