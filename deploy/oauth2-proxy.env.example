# oauth2-proxy (compose profile "sso"): log in through your identity provider
# (Keycloak, Authelia, Authentik, Google, ...) instead of MD_PASSWORD.
# Copy to deploy/oauth2-proxy.env (git-ignored). Also set in .env:
#   MD_NGINX_CONF=money-doctor-sso.conf
#   MD_AUTH=proxy
#   MD_PROXY_HEADER=X-Auth-Request-Email
#   MD_TRUSTED_PROXIES=172.30.50.10
#
# In your provider, create an OIDC client with the redirect URL below.

OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.com/realms/home
OAUTH2_PROXY_CLIENT_ID=money-doctor
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://money.example.com/oauth2/callback
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_SCOPE=openid email profile

# Who may log in: everyone with an email at these domains ("*" = anyone your
# provider lets through), or limit it to a group.
OAUTH2_PROXY_EMAIL_DOMAINS=*
# OAUTH2_PROXY_OIDC_GROUPS_CLAIM=groups
# OAUTH2_PROXY_ALLOWED_GROUPS=money-users

# nginx asks oauth2-proxy about each request (auth_request); leave these as they are.
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_UPSTREAMS=static://202
