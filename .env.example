# Copy to .env (git-ignored). Everything else lives in the /data volume.

# --- Docker Compose (see compose.example.yml)
# COMPOSE_PROFILES=email,tunnel    # optional services: email, tunnel, nginx, sso
# MD_NGINX_CONF=money-doctor.conf  # money-doctor-sso.conf with the sso profile

# --- Website
MD_PUBLIC_URL=https://money.example.com   # the URL you open the site at (used in links and Shortcut setup)
MD_AUTH=password                 # password | proxy | none (none = local development only)
MD_PASSWORD=change-me            # website login (MD_AUTH=password)
MD_SECRET=                       # random string; keeps you logged in across restarts: openssl rand -hex 32
# MD_AUTH=proxy only: the header your SSO proxy (e.g. oauth2-proxy) sets, and the
# proxy's IP address. Only requests from that IP may set the header.
MD_PROXY_HEADER=X-Auth-Request-Email
MD_TRUSTED_PROXIES=172.30.50.10    # the nginx in compose.example.yml
# TZ=America/Chicago             # container clock; the morning email uses `timezone` in budget.yaml

# --- iPhone Shortcuts (optional). By default Shortcuts call {MD_PUBLIC_URL}/api/v1
# with a bearer token. Behind a gateway such as Cloudflare Access:
# MD_SHORTCUT_BASE=https://api.example.com/money
# MD_SHORTCUT_AUTH=cloudflare-access   # bearer | cloudflare-access

# --- Morning email (SMTP). Until SMTP_HOST is set, the email is skipped.
# The postfix relay in compose (profile "email", see deploy/postfix.env.example):
#   SMTP_HOST=postfix  SMTP_PORT=25
# Or straight to a provider, no container (Gmail: an app password, not your normal one):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS=true
#   SMTP_USER=you@gmail.com   SMTP_PASSWORD=
# Then put your address in digest.to in data/budget.yaml.
MD_DIGEST=true                   # false turns the daily email off
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=Money Doctor <you@gmail.com>
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false

# --- Payment emails (optional): Venmo / Cash App / PayPal / bank alerts in a
# Gmail label, read over IMAP with a Gmail app password. See Settings -> iPhone setup.
# MAIL_USER=you@gmail.com
# MAIL_PASSWORD=                 # Gmail app password, not your normal password
# MAIL_FOLDER=Money Doctor
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_POLL_SECONDS=120

# --- Reading statement PDFs that aren't recognized formats (optional)
MD_EXTRACT_BACKEND=none          # none | local | claude   (claude-code only works outside Docker)
OLLAMA_URL=http://192.168.1.50:11434
OLLAMA_MODEL=qwen3:14b
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
